{
  "note": "The client's own functions for opening an archive file, reading it whole, and letting it go, in Py4GW Reforged's offset format (docs/port/22-client-platform.md). Ported unchanged from Py4GW Reforged Native at 82e4746, offsets/gw_dat_reader.json: five of its eight resolvers, with the five patterns they use; the three it has for decoding images are not carried. Their prototypes are in that project's include/GW/textures/gw_dat_reader.h:42-49. Nothing in Kryta.dll calls or hooks these yet: this file is phase 1 of docs/port/24-custom-maps.md, and a resolver here that does not match does not stop a client.",
  "namespace": "files",
  "patterns": {
    "amet_data_anchor": {
      "doc": "The assertion 'data' of Amet.cpp, in the function that opens a file by name and reads it whole.",
      "assertion_file": "Amet.cpp",
      "assertion_message": "data",
      "line_number": "0",
      "offset": "0x0",
      "section": "text"
    },
    "amet_compare": {
      "doc": "cmp dword ptr [edx], 'AMET': the same function, after the read.",
      "pattern": "\\x81\\x3a\\x41\\x4d\\x45\\x54",
      "mask": "xxxxxx",
      "offset": "0x0",
      "section": "text"
    },
    "open_file_anchor": {
      "doc": "The assertion of File.cpp inside the function that opens an archive file by its file id.",
      "assertion_file": "File.cpp",
      "assertion_message": "!(flags & (FILE_OPEN_READ | FILE_OPEN_WRITE) & ~source.m_flags)",
      "line_number": "0",
      "offset": "0x0",
      "section": "text"
    },
    "near_call": {
      "doc": "A near call.",
      "pattern": "\\xe8",
      "mask": "x",
      "offset": "0x0",
      "section": "text"
    },
    "push_esi_call": {
      "doc": "push esi; call.",
      "pattern": "\\x56\\xe8",
      "mask": "xx",
      "offset": "0x0",
      "section": "text"
    }
  },
  "resolvers": {
    "open_file_by_file_id_func": {
      "doc": "RecObj* __cdecl (u32 archive, u32 file_id, u32 stream_id, u32 flags, u32* error_out).",
      "on_fail": "continue",
      "steps": [
        { "name": "scan_anchor", "op": "scan", "pattern": "open_file_anchor", "out": "scan" },
        { "name": "to_function_start", "op": "to_function_start", "in": "scan", "scan_range": "0xfff", "out": "final" }
      ]
    },
    "file_hash_to_rec_obj_func": {
      "doc": "RecObj* __cdecl (const wchar_t* name, int, int): open by the file's name.",
      "on_fail": "continue",
      "steps": [
        { "name": "scan_anchor", "op": "scan", "pattern": "amet_data_anchor", "out": "anchor" },
        { "name": "find_call", "op": "find_in_range", "pattern": "near_call", "start": "anchor", "start_add": "0xc", "end": "anchor", "end_add": "0xff", "out": "callsite" },
        { "name": "resolve_target", "op": "function_from_near_call", "in": "callsite", "out": "final" }
      ]
    },
    "read_file_buffer_func": {
      "doc": "u8* __cdecl (RecObj* rec, int* size_out): the whole file as bytes.",
      "on_fail": "continue",
      "steps": [
        { "name": "scan_anchor", "op": "scan", "pattern": "amet_data_anchor", "out": "anchor" },
        { "name": "find_first_call", "op": "find_in_range", "pattern": "near_call", "start": "anchor", "start_add": "0xc", "end": "anchor", "end_add": "0xff", "out": "first_call" },
        { "name": "find_second_call", "op": "find_in_range", "pattern": "near_call", "start": "first_call", "start_add": "0x1", "end": "first_call", "end_add": "0xff", "out": "callsite" },
        { "name": "resolve_target", "op": "function_from_near_call", "in": "callsite", "out": "final" }
      ]
    },
    "close_rec_obj_func": {
      "doc": "void __cdecl (RecObj* rec).",
      "on_fail": "continue",
      "steps": [
        { "name": "scan_compare", "op": "scan", "pattern": "amet_compare", "out": "anchor" },
        { "name": "find_call", "op": "find_in_range", "pattern": "push_esi_call", "start": "anchor", "start_add": "0x0", "end": "anchor", "end_add": "-0xff", "out": "push_site" },
        { "name": "advance_to_call", "op": "add", "in": "push_site", "value": "0x1", "out": "callsite" },
        { "name": "resolve_target", "op": "function_from_near_call", "in": "callsite", "out": "final" }
      ]
    },
    "free_file_buffer_func": {
      "doc": "void __cdecl (RecObj* rec, u8* bytes): give the bytes back.",
      "on_fail": "continue",
      "steps": [
        { "name": "scan_compare", "op": "scan", "pattern": "amet_compare", "out": "anchor" },
        { "name": "find_first_call", "op": "find_in_range", "pattern": "push_esi_call", "start": "anchor", "start_add": "0x0", "end": "anchor", "end_add": "-0xff", "out": "first_push" },
        { "name": "find_second_call", "op": "find_in_range", "pattern": "push_esi_call", "start": "first_push", "start_add": "-0x1", "end": "first_push", "end_add": "-0xff", "out": "second_push" },
        { "name": "advance_to_call", "op": "add", "in": "second_push", "value": "0x1", "out": "callsite" },
        { "name": "resolve_target", "op": "function_from_near_call", "in": "callsite", "out": "final" }
      ]
    }
  }
}
