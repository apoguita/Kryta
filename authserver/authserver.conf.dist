# authserver.conf.dist - the auth program's own configuration.
#
# Reference: src/server/apps/authserver/authserver.conf.dist. One config file per program:
# this program reads this file and no other, and a key it does not know is a start-up error
# unless --config-policy says otherwise.
#
# Only the keys the ported stages read are here. A stage that lands adds the keys it reads,
# with the reference's own default. The format is the reference's: `Key = value`.

[worldserver]

###################################################################################################################

# Where this program answers login connections.
# Reference: `GetOption<int32>("RealmServerPort", 3724)`.
RealmServerPort = 3724

# The address the listener binds. 0.0.0.0 is every interface.
BindIP = "0.0.0.0"

# How often the program reports that it is alive and how many connections it has accepted, in
# seconds. This key is this project's own: the reference has no such line, and this server cannot be
# tested without one.
# Every statement the database layer runs, as a debug line.
# Off by default, and it needs its own logger: Logger.sql.trace = 6,Console Auth
Database.Trace = 0

# Every byte of every connection, in and out, as a debug line.
# Off by default: it is an instrument for an investigation, not a default.
Network.Trace = 0

StatusInterval = 30

# Written when a PID is wanted for a service manager. Empty writes nothing.
PidFile = ""

# How often the world list is refreshed, in seconds.
# Reference: `RealmsStateUpdateDelay` (20).
RealmsStateUpdateDelay = 20

# How often the login database is pinged, in minutes.
# Reference: `MaxPingTime` (30).
MaxPingTime = 30

# How often expired bans are cleared, in seconds.
# Reference: `BanExpiryCheckInterval` (60).
BanExpiryCheckInterval = 60

###################################################################################################################

# Logging. Reference: the same four lines in
# src/server/apps/authserver/authserver.conf.dist, with the same values.
#
# LogsDir is where file appenders write. Empty means the working directory.
LogsDir = ""

# Appender.<name> = Type,Level,Flags,optional...
#   Type  1 is the console; its optional field is the colour list for
#         "fatal error warn info debug trace".
#   Type  2 is a file: the name, then the mode (a append, w overwrite).
Appender.Console = 1,5,0,"1 9 3 6 5 8"
Appender.Auth    = 2,5,0,Auth.log,w

# Logger.<name> = Level,AppenderList
# A logger inherits from its dotted parent and finally from root.
# The byte trace's own logger. Its level is what decides whether Network.Trace shows anything:
# 6 is Trace, which is where the bytes are written.
Logger.network.trace = 6,Console Auth

Logger.root = 4,Console Auth