{
  "note": "authserver.json.dist - the auth program's own configuration. Reference: src/server/apps/authserver/authserver.conf.dist, whose setting names these are; the format is this project's (docs/decisions/0005-json-configuration.md). One file per program: this program reads this file and no other. Only the settings the ported stages read are here - a setting arrives with the stage that reads it, so a key in this file is one the program actually uses.",

  "RealmServerPort": {
    "value": 6112,
    "doc": "Where this program answers login connections. Reference: GetOption<int32>(\"RealmServerPort\", 3724). It is 6112 here because that is the port this client was launched against and reaches; 3724 is the reference's default and no client of this game asks for it."
  },

  "CreationMap": {
    "value": 0,
    "doc": "The map id that means the character-creation instance. A client naming it as a place - which this client does when a character is clicked, 0x8029 with map 0 and type 0 - is placed where the character's row says instead (game/src/Maps/Placement.rs). 0 is the creation instance's own id in the world's catalogue."
  },
  "FallbackOutpost": {
    "value": 148,
    "doc": "Where a character whose row names no map and which has never been in an outpost enters. A setting rather than a rule: the outpost a character starts in is written by creation and by travelling, never derived, and this program holds no map catalogue to pick one from (docs/port/04-configuration.md)."
  },
  "EquippedBag": {
    "value": 5,
    "doc": "The id of the bag a character wears things in. The login's character list draws each character's armour from the items in this bag (slots 2 to 6: body, legs, head, boots, gloves). It must be the bag the world's creation inventory gives type 2 and model 21 (config/World/Vanilla/creation/inventory.json); a different number lists every character with no armour."
  },
  "BindIP": {
    "value": "0.0.0.0",
    "doc": "The address the listener binds. 0.0.0.0 is every interface."
  },

  "PidFile": {
    "value": "",
    "doc": "Written when a PID is wanted for a service manager. Empty writes nothing."
  },

  "StatusInterval": {
    "value": 5,
    "doc": "How often the program writes its own status line, in seconds: how long it has been up, where it listens, and how many connections it has accepted. A server that cannot say whether anything reached it cannot be tested."
  },

  "Log": {
    "EffectiveConfig": {
      "value": true,
      "doc": "Every key this program read from this file, with any database password masked, at debug. It needs its logger: Logger.server.loading = 6,Console Auth."
    }
  },

  "Portal": {
    "Enable": {
      "value": true,
      "doc": "The portal the client takes its identity from before it logs in: four HTTP endpoints. This program serves it (docs/decisions/0003-portal-host.md), and the accounts it answers from are data/accounts.json."
    },
    "Bind": {
      "value": "127.0.0.1:6601",
      "doc": "Where those endpoints answer. The client was launched with -portal 127.0.0.1 and speaks to localhost:6601."
    }
  },

  "ClientLink": {
    "Enable": {
      "value": true,
      "doc": "The link Kryta.dll opens from inside a patched client when the client starts (docs/port/22-client-platform.md). This program serves it: over it a client is given the offsets its DLL finds the client's functions by, and the custom title text. A patched client does not start without it."
    },
    "Bind": {
      "value": "127.0.0.1:6650",
      "doc": "Where the link answers. Kryta.dll dials the -portal host of the client's command line on port 6650 unless a Kryta.json beside the client names another address."
    },
    "Directory": {
      "value": "config/Client",
      "doc": "The folder of what a client's DLL is given: every *.json under its offsets folder is one offset document (config/Client/README.md). Read once at start-up; a missing folder or a broken file stops the program."
    },
    "TitleWorldConfig": {
      "value": "worldserver/worldserver.json",
      "doc": "World program configuration whose WorldPack supplies the custom title text a client's DLL is sent. An empty value sends none."
    },
    "MapPartPauseMs": {
      "value": 0,
      "doc": "Milliseconds the server waits before each 256 KiB part of a map file it sends to a client (docs/port/24-custom-maps.md, D8). 0 sends at full speed, which is what a server in use wants. A value above 0 stands in for a slow link or a very large map, to try a map load that has to wait for its file: a 2.9 MB map is 12 parts, so 5000 makes it take a minute."
    }
  },

  "Network": {
    "Threads": {
      "value": 1,
      "doc": "Threads serving the accepted sockets, for both listeners this program opens. Reference: Network.Threads, whose default is this. Must be greater than 0; a connection goes to the thread with the fewest already."
    },
    "Trace": {
      "value": true,
      "doc": "Every byte of every connection, in and out, as a debug line. Off by default in a served server: it is an instrument for an investigation. It needs its logger: Logger.network.trace = 6,Console Auth."
    }
  },

  "Database": {
    "Trace": {
      "value": true,
      "doc": "Every statement the database layer runs, as a debug line. It needs its logger: Logger.sql.trace = 6,Console Auth."
    }
  },

  "RealmsStateUpdateDelay": {
    "value": 20,
    "doc": "How often the world list is refreshed, in seconds. Reference: RealmsStateUpdateDelay, whose default is this."
  },

  "WorldsFile": {
    "value": "data/realms.json",
    "doc": "The file a world can also be described in, merged over the realmlist table: a row with an id the table holds overrides it field by field, a row with a new id is added. Empty means the table alone."
  },

  "LoginDatabaseInfo": {
    "value": "127.0.0.1;5432;kryta;change-me;kryta_login",
    "doc": "host;port;user;password;database, as the reference spells it. The fourth field is a password: it is masked in every log line this program prints, and this file is not committed with a real one. The role and the databases were created for this project."
  },

  "LoginDatabase": {
    "WorkerThreads": {
      "value": 2,
      "doc": "Asynchronous connections to the login database."
    },
    "SynchThreads": {
      "value": 1,
      "doc": "Synchronous connections, used where the caller cannot wait for a callback."
    }
  },

  "CharacterDatabaseInfo": {
    "value": "127.0.0.1;5432;kryta;change-me;kryta_characters",
    "doc": "host;port;user;password;database - a login's answer lists the account's characters, and those are rows in this database. The fourth field is a password, masked in every log line."
  },

  "CharacterDatabase": {
    "WorkerThreads": {
      "value": 2,
      "doc": "Asynchronous connections to the character database."
    },
    "SynchThreads": {
      "value": 1,
      "doc": "Synchronous connections to it."
    }
  },

  "LogsDir": {
    "value": "",
    "doc": "Where file appenders write. Empty means the working directory."
  },

  "Appender": {
    "Console": {
      "value": [1, 4, 0, "1 9 3 6 5 8"],
      "doc": "Type, level, flags, then the type's own fields. Type 1 is the console and its last field is the colour list for fatal, error, warn, info, debug, trace. The levels are 1 fatal to 6 trace; 4 is info. A line about one connection is written at debug, so this level shows the login program's own state and its problems, not its traffic."
    },
    "Auth": {
      "value": [2, 5, 0, "Auth.log", "w"],
      "doc": "Type 2 is a file: the name, then the mode (a append, w overwrite)."
    }
  },

  "Logger": {
    "root": {
      "value": [4, "Console Auth"],
      "doc": "Level, then appender names. A logger inherits from its dotted parent and finally from root."
    },
    "network.trace": {
      "value": [6, "Console Auth"],
      "doc": "The byte trace's own logger. Its level is what decides whether Network.Trace shows anything: 6 is trace, which is where the bytes are written."
    },
    "sql.trace": {
      "value": [6, "Console Auth"],
      "doc": "The database trace's own logger, read the same way."
    },
    "auth.trace": {
      "value": [6, "Console Auth"],
      "doc": "The decrypted body of each message the client sends, which the byte trace cannot show: it holds the ciphertext, and the key is per connection."
    },
    "server.loading": {
      "value": [6, "Console Auth"],
      "doc": "The effective configuration dump, and the loading stages."
    }
  }
}
