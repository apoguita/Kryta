{
  "note": "manage.json - the control panel's own configuration. The panel reads and writes the login and character databases and reads the content files; it is not a game server and no client talks to it. The service answers JSON under /api/v1/ and serves its own static pages at / (docs/port/23-control-panel.md).",

  "information": {
    "what this program is for": "everything an operator does without playing: accounts (create, edit, activate, the EULA version, delete), characters (create, rename, level, delete), the stack's services, the world's operations, and reading the content, the settings, the schema record and the recordings.",
    "why it is not part of a server program": "the two server programs serve clients, and a client-facing listener must not carry operator power. This is a third binary in tools/, and neither server knows it exists.",
    "where it writes": "rows in kryta_login and kryta_characters, the path-graph cache (PathGraphsFile), and one appended line per indexed recording in recordings/index.jsonl. From the settings page it writes one value at a time into a program's settings file in the running flavor or into config/machine.json, whichever states the value. From the flavors page it writes the name in config/flavor.json and copies a flavor's folder into a new one. Content files are shown, never rewritten."
  },

  "Bind": {
    "value": "127.0.0.1",
    "doc": "The address the panel is served on. Loopback by default. On a loopback address the service also refuses any request whose Host header is not 127.0.0.1, localhost or [::1] with this port. Any other address drops that check and lets other machines reach the panel: set Token when you do that."
  },

  "Port": {
    "value": 6602,
    "doc": "The port the panel is served on. Beside the portal's 6601 and away from the two server ports."
  },

  "Token": {
    "value": "",
    "doc": "Empty requires no token, which is the default for a local tool. When set, every /api/ request must carry 'Authorization: Bearer <value>'; the static pages load without it and show an unlock screen that asks for the token once and keeps it for that browser tab (sessionStorage). Separately from the token, every request that changes something must carry the header 'X-Kryta-Panel: 1', which the panel's own pages send and another site's form cannot."
  },

  "LoginDatabaseInfo": {
    "value": "",
    "doc": "The login database, in the reference's shape: host;port;user;password;database. Empty refuses to start - a tool that cannot say which database it changes changes nothing."
  },

  "LoginDatabase": {
    "WorkerThreads": {
      "value": 1,
      "doc": "Asynchronous connections in the pool."
    },
    "SynchThreads": {
      "value": 1,
      "doc": "Synchronous connections in the pool."
    }
  },

  "CharacterDatabaseInfo": {
    "value": "",
    "doc": "The character database, in the same shape. Empty leaves the character pages switched off rather than failing every request."
  },

  "CharacterDatabase": {
    "WorkerThreads": {
      "value": 1,
      "doc": "Asynchronous connections in the pool."
    },
    "SynchThreads": {
      "value": 1,
      "doc": "Synchronous connections in the pool."
    }
  },

  "WorldDatabaseInfo": {
    "value": "",
    "doc": "The world database, in the same shape: the running instances the world program writes, and that database's schema record. The maps and the creation lists are not here; they are read from the world's pack. Empty leaves the running copies and the world schema out."
  },

  "WorldDatabase": {
    "WorkerThreads": {
      "value": 1,
      "doc": "Asynchronous connections in the pool."
    },
    "SynchThreads": {
      "value": 1,
      "doc": "Synchronous connections in the pool."
    }
  },
  "ConfigFolder": {
    "value": "config",
    "doc": "The configuration folder: where flavor.json, machine.json and flavors/ are (docs/decisions/0016-a-server-is-a-flavor.md). The panel follows the flavor that flavor.json names, as the two programs do: its Flavors page lists the flavors, chooses the one this machine runs and makes a new one as a copy; its Settings page shows the two programs' settings in that flavor with this machine's own values over them, and changes a value in the file that states it; its Content page reads that flavor's world. Relative to where the tool is started."
  },
  "PathGraphsFile": {
    "value": "data/path-graphs.bin",
    "doc": "The portable extracted navigation cache. The panel inspects this file on its Navigation page (GET /api/v1/navigation); it is the file worldserver reads, never Gw.dat."
  },
  "MapArchiveFile": {
    "value": "",
    "doc": "An optional client archive used only when the panel explicitly dumps one selected map into PathGraphsFile (POST /api/v1/navigation/dump). Empty disables the dump action. Worldserver never reads this setting."
  },

  "ControlPort": {
    "value": 0,
    "doc": "The running world's local control port (`Control.Port` in its own settings), for the Console page and the overview's world status. Zero leaves them saying no endpoint is configured, which is not an empty result."
  },
  "ControlCredentialFile": {
    "value": "",
    "doc": "The service credential file the world program requires (`Control.CredentialFile` in its settings). Create it with `cargo run -p worldserver --bin kryta-cli -- init-credential <file>`; the tool only reads it."
  },
  "ControlTimeoutSeconds": {
    "value": 5,
    "doc": "How long a request waits for the world before reporting it unavailable. The world executes the operation on its own update thread, so a timeout is not proof the request was refused."
  },

  "SupervisorStackFile": {
    "value": "tools/supervisor/stack.json",
    "doc": "The supervisor's existing stack list. The manager reads only its control_port and asks that running supervisor for status, stop, and restart; it never starts or owns a process. Empty leaves the Services page disconnected."
  },
  "SupervisorTimeoutSeconds": {
    "value": 20,
    "doc": "How long a Services-page request waits for the supervisor's own answer. A timeout does not prove a lifecycle action did not occur."
  },

  "LogsDir": {
    "value": "",
    "doc": "Where the appender writes. Empty means the working directory."
  },

  "Appender": {
    "Console": {
      "value": [1, 4, 0, "1 9 3 6 5 8"],
      "doc": "Type, level, flags, then the type's own fields. Type 1 is the console and its last field is the colour list for fatal, error, warn, info, debug, trace."
    }
  },

  "Logger": {
    "root": {
      "value": [4, "Console"],
      "doc": "Level, then appender names."
    }
  }
}
