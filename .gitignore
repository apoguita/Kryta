# Build output
/research/
/target
**/*.rs.bk
*.pdb
*.ilk

# Logs and local config
/logs
*.log
/env
.env

# Python's cache: the capture tools import one another, which leaves .pyc files behind.
__pycache__/
*.pyc

# What one machine alone knows - database logins, addresses, ports - is config/machine.json. Its
# `.dist` is committed; the operator copies it and the copy never leaves the machine. A flavor's
# own settings (config/flavors/<flavor>/) hold no secret and are committed
# (docs/decisions/0016-a-server-is-a-flavor.md).
/config/machine.json
*.pid

# The reference's client archive is never committed
*.dat
tools/manage/manage.json

# The world program's loopback control credential: a secret every local caller must present.
# `cargo run -p worldserver --bin kryta-cli -- init-credential <file>` creates it, restricted to the
# service user; it is never committed and never leaves the machine.
/worldserver/control.credential
